NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

DATABASE_URL=postgresql://devsecops:devsecops@localhost:5432/devsecops?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Démarrage automatique de Redis si le port est fermé (npm run ensure:redis)
# Commande complète personnalisée (prioritaire sur MEMURAI_EXE) :
REDIS_START_CMD=
# Binaire et configuration à utiliser (sinon détection automatique) :
MEMURAI_EXE=
MEMURAI_CONF=
# Intervalle de surveillance du mode `npm run redis:watch` (ms)
REDIS_WATCH_INTERVAL=5000

JWT_ACCESS_SECRET=changeme-at-least-32-characters-long
JWT_REFRESH_SECRET=changeme-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

MASTER_ENCRYPTION_KEY=changeme-32-bytes-base64

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

GIT_MIRROR_PREFIX=

# Binaires locaux (adapter selon la machine)
GITLEAKS_BIN=
TRIVY_BIN=
GIT_BIN=
NPM_BIN=
SEMGREP_BIN=
TRIVY_CACHE_DIR=

# Résilience réseau de pip (installation des dépendances Python)
# Le worker rejoue automatiquement les erreurs DNS/timeouts transitoires.
PIP_INSTALL_ATTEMPTS=3
PIP_INSTALL_RETRY_DELAY_MS=3000
PIP_RETRIES=5
PIP_DEFAULT_TIMEOUT=60
# Miroir PyPI optionnel (entreprise / réseau filtré).
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
# Cache local de wheels (ignoré dans la sandbox : aucun chemin hôte n'est
# monté ; utiliser PIP_INDEX_URL ou un miroir réseau).
PIP_WHEELHOUSE=

# SCA Python (pip-audit)
# Outil de scan installé sur l'hôte (jamais du code du dépôt). Exemple :
# PIP_AUDIT_BIN=D:/ProjetL3/Outils/pip-audit/Scripts/pip-audit.exe
PIP_AUDIT_BIN=
# osv = une seule requête batch (recommandé sur réseau instable) ;
# pypi = une requête par paquet (défaut historique de l'outil).
PIP_AUDIT_SERVICE=osv
PIP_AUDIT_TIMEOUT=60
PIP_AUDIT_ATTEMPTS=3

# Docker build sur la VM
# Vide = réseau Docker par défaut. `host` contourne un résolveur Docker
# injoignable depuis les conteneurs de build (systemd-resolved 127.0.0.53).
DOCKER_BUILD_NETWORK=
DOCKER_BUILD_ATTEMPTS=2
# Délai maximal d'un build sur la VM (millisecondes).
DOCKER_BUILD_TIMEOUT_MS=1200000

# --- Sandbox d'exécution du code des dépôts (INSTALL_DEPS / TESTS) ---
# Aucune commande du dépôt n'est exécutée sur l'hôte du worker. Si aucun
# moteur Docker n'est joignable, ces étapes échouent explicitement.
# auto = ssh-docker si la configuration SSH est complète, sinon local-docker.
SANDBOX_BACKEND=auto
SANDBOX_SSH_HOST=
SANDBOX_SSH_PORT=22
SANDBOX_SSH_USER=
SANDBOX_SSH_KEY_PATH=
SANDBOX_SSH_PASSPHRASE=
SANDBOX_SSH_READY_TIMEOUT_MS=30000
# Images pré-téléchargées sur le moteur (aucun pull implicite).
SANDBOX_NODE_IMAGE=node:24-alpine
SANDBOX_PYTHON_IMAGE=python:3.12-slim
SANDBOX_PHP_IMAGE=composer:2
# Limites du conteneur. Adapter à la capacité du moteur.
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS=512
SANDBOX_TMPFS_MB=1024
SANDBOX_MAX_WORKSPACE_MB=2048
SANDBOX_MAX_ARCHIVE_MB=512
SANDBOX_MIN_FREE_DISK_MB=1024
# Délais par opération (millisecondes).
SANDBOX_INSTALL_TIMEOUT_MS=900000
SANDBOX_TEST_TIMEOUT_MS=900000
SANDBOX_UPLOAD_TIMEOUT_MS=600000
# Les tests sont hors-ligne par défaut ; `egress` est une exception.
SANDBOX_TEST_NETWORK=none
SANDBOX_EGRESS_NETWORK=devsecops-sandbox-egress
# Conteneurs orphelins plus vieux que cette durée sont balayés au démarrage.
SANDBOX_ORPHAN_MAX_AGE_HOURS=12

# ZAP local : évite de télécharger l'image Docker (~2,4 Go compressés)
# sur une VM de déploiement à l'espace disque limité.
# ZAP_BIN est prioritaire ; sinon ZAP_HOME est utilisé pour trouver zap.bat (Windows)
# ou zap.sh (Linux/macOS).
ZAP_BIN=
ZAP_HOME=
ZAP_LOCAL_TIMEOUT_MS=1200000
ZAP_PULL_TIMEOUT_MS=1800000

# Trivy sur la VM : volume Docker contenant trivy/db/{trivy.db,metadata.json}
TRIVY_VM_CACHE_VOLUME=trivy-cache
TRIVY_VM_IMAGE=aquasec/trivy:latest

# Nettoyage des artefacts Docker sur la VM de déploiement (worker)
# Nombre d'images conservées par projet : l'image en production + l'image
# précédente (cible du rollback). En dessous, le rollback est impossible.
DOCKER_IMAGE_RETENTION=2
# Rétention du cache de build Docker sur la VM. Vide = pas d'élagage.
DOCKER_BUILD_CACHE_RETENTION=24h

# Rapports HTML/PDF générés par le worker
REPORTS_DIR=

# Supply chain (SBOM / signature)
# Image Syft utilisée sur la VM de déploiement
SYFT_IMAGE=anchore/syft:latest
# Chemin de la clé privée Cosign SUR LA VM (pas sur le poste du worker)
COSIGN_PRIVATE_KEY_PATH=
# Chemin de la clé publique Cosign SUR LA VM (vérification optionnelle)
COSIGN_PUBLIC_KEY_PATH=
# Mot de passe de la clé Cosign (vide si clé non chiffrée)
COSIGN_PASSWORD=
# Registre cible (ex. ghcr.io/mon-compte). Vide = signature locale dégradée.
COSIGN_REGISTRY=
COSIGN_REGISTRY_USERNAME=
COSIGN_REGISTRY_PASSWORD=
