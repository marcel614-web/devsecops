// devsecops-platform/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  DEVELOPER
}

enum GitProvider {
  GITHUB
  GITLAB
}

enum Technology {
  NODEJS
  PHP
  PYTHON
  UNKNOWN
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  SECURITY_BLOCKED
  CANCELLED
}

enum StepStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  SECURITY_BLOCKED
  CANCELLED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum ScanType {
  SECRET
  SAST
  SCA
  IMAGE
  IAC
  DAST
}

enum SecurityGateStatus {
  PASSED
  WARNING
  FAILED
  BLOCKED
}

enum SecurityGateMode {
  WARNING
  ENFORCEMENT
}

enum VulnerabilityStatus {
  OPEN
  CONFIRMED
  FIXED
  FALSE_POSITIVE
  RISK_ACCEPTED
  DUPLICATE
}

enum DeploymentStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ServerAuthType {
  SSH_KEY
  PASSWORD
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(DEVELOPER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects            Project[]
  githubInstallations GitHubInstallation[]
  servers             DeploymentServer[]
  auditLogs           AuditLog[]
  securityGateExceptions SecurityGateException[]
  assignedVulnerabilities Vulnerability[]

  @@index([email])
  @@index([role])
}

// ============================================================
// GITHUB APP
// ============================================================

/// Une installation GitHub App (peut être un compte perso ou une organisation).
/// Un utilisateur peut avoir plusieurs installations (perso + orgs).
model GitHubInstallation {
  id             String    @id @default(cuid())
  installationId String    @unique // ID numérique GitHub (stocké en string)
  accountLogin   String // "marcel614-web" ou "mon-org"
  accountType    String // "User" | "Organization"
  accountId      String // ID GitHub du compte
  targetType     String // "User" | "Organization"
  userId         String // propriétaire côté plateforme
  suspendedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]

  @@index([userId])
  @@index([accountLogin])
  @@index([revokedAt])
}

/// Un repository accessible via une installation GitHub App.
/// Synchronisé depuis l'API GitHub à la demande.
model GitHubRepository {
  id             String   @id @default(cuid())
  repositoryId   String // ID numérique GitHub (stocké en string)
  fullName       String // "owner/repo"
  owner          String
  name           String
  private        Boolean  @default(false)
  defaultBranch  String   @default("main")
  language       String?
  description    String?
  htmlUrl        String
  installationId String // FK vers GitHubInstallation.id (pas l'ID GitHub)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([installationId, repositoryId])
  @@index([installationId])
  @@index([fullName])
  @@index([repositoryId])
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id                String      @id @default(cuid())
  ownerId           String
  name              String
  description       String?
  provider          GitProvider @default(GITHUB)
  repoFullName      String // gardé pour compat + affichage rapide
  repoId            String // ID GitHub du repository (garde pour compat)
  defaultBranch     String      @default("main")
  technology        Technology  @default(UNKNOWN)
  deploymentEnabled Boolean     @default(false)
  serverId          String?
  githubRepositoryId String? // FK vers GitHubRepository
  monitoredBranch   String? // branche surveillée par les webhooks
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  owner            User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  server           DeploymentServer?   @relation(fields: [serverId], references: [id], onDelete: SetNull)
  githubRepository GitHubRepository?   @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  config           ProjectConfiguration?
  pipelines        Pipeline[]
  scans            SecurityScan[]
  deployments      Deployment[]
  reports          SecurityReport[]
  securityGateExceptions SecurityGateException[]
  sboms            Sbom[]

  @@unique([ownerId, repoFullName])
  @@index([ownerId])
  @@index([repoFullName])
  @@index([githubRepositoryId])
}

model ProjectConfiguration {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  triggerBranches      String[]
  gitleaksEnabled      Boolean  @default(true)
  semgrepEnabled       Boolean  @default(true)
  scaEnabled           Boolean  @default(true)
  iacEnabled           Boolean  @default(true)
  trivyEnabled         Boolean  @default(true)
  syftEnabled          Boolean  @default(true)
  zapEnabled           Boolean  @default(true)
  cosignEnabled        Boolean  @default(false)
  securityGateCritical Int      @default(0)
  securityGateHigh     Int      @default(2)
  securityGateMedium   Int      @default(10)
  securityGateLow      Int      @default(-1)
  gateMode             SecurityGateMode @default(WARNING)
  gateEnforcementAt    DateTime?
  gateSecretsEnabled   Boolean  @default(true)
  gateSastEnabled      Boolean  @default(true)
  gateScaEnabled       Boolean  @default(true)
  gateIacEnabled       Boolean  @default(true)
  gateImageEnabled     Boolean  @default(true)
  gateDastEnabled      Boolean  @default(true)
  deploymentStrategy   String   @default("direct") // direct | staging_then_production
  stagingPort          Int      @default(8081)
  autoRollback         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// PIPELINES
// ============================================================

model Pipeline {
  id         String         @id @default(cuid())
  projectId  String
  commitSha  String
  branch     String
  author     String
  trigger    String         @default("push")
  status     PipelineStatus @default(QUEUED)
  pullRequestNumber Int?
  pullRequestUrl    String?
  baseBranch        String?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps       PipelineStep[]
  logs        PipelineLog[]
  scans       SecurityScan[]
  gateResult  SecurityGateResult?
  deployment  Deployment?
  report      SecurityReport?
  dockerImage DockerImage?
  sbom        Sbom?

  @@index([projectId])
  @@index([status])
  @@index([commitSha])
  @@index([createdAt])
}

model PipelineStep {
  id         String     @id @default(cuid())
  pipelineId String
  name       String
  type       String
  order      Int
  status     StepStatus @default(QUEUED)
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  exitCode   Int?
  resultJson Json?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  logs     PipelineLog[]

  @@index([pipelineId])
  @@index([status])
  @@unique([pipelineId, order])
}

model PipelineLog {
  id         String   @id @default(cuid())
  pipelineId String
  stepId     String?
  level      String   @default("info")
  message    String
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  step     PipelineStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@index([stepId])
  @@index([createdAt])
}

// ============================================================
// SECURITY
// ============================================================

model SecurityScan {
  id            String     @id @default(cuid())
  pipelineId    String
  projectId     String
  scanner       String
  type          ScanType
  status        StepStatus @default(QUEUED)
  criticalCount Int        @default(0)
  highCount     Int        @default(0)
  mediumCount   Int        @default(0)
  lowCount      Int        @default(0)
  infoCount     Int        @default(0)
  rawResultJson Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  exitCode      Int?
  createdAt     DateTime   @default(now())

  pipeline        Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vulnerabilities Vulnerability[]

  @@index([pipelineId])
  @@index([projectId])
  @@index([scanner])
}

model Vulnerability {
  id           String   @id @default(cuid())
  scanId       String
  tool         String
  technology   String?
  severity     Severity
  packageName  String?
  filePath     String?
  version      String?
  fixedVersion String?
  description  String?
  reference    String?
  fingerprint  String?
  status       VulnerabilityStatus @default(OPEN)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  occurrences  Int      @default(1)
  assignedToId String?
  notes        String?
  dueDate      DateTime?
  detectedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  scan       SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([severity])
  @@index([tool])
  @@index([fingerprint])
  @@index([status])
  @@index([assignedToId])
}

model SecurityGateResult {
  id         String             @id @default(cuid())
  pipelineId String             @unique
  status     SecurityGateStatus
  mode       SecurityGateMode   @default(WARNING)
  rulesJson  Json
  critical   Int                @default(0)
  high       Int                @default(0)
  medium     Int                @default(0)
  low        Int                @default(0)
  blocked    Boolean            @default(false)
  reason     String?
  technicalFailures Json?
  exceptionsApplied Json?
  createdAt  DateTime           @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status])
}

model DockerImage {
  id         String   @id @default(cuid())
  pipelineId String   @unique
  imageTag   String
  imageId    String?
  sizeBytes  BigInt?
  registry   String?
  signed     Boolean  @default(false)
  signatureRef String?
  createdAt  DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model Sbom {
  id           String   @id @default(cuid())
  pipelineId   String   @unique
  projectId    String
  format       String   @default("syft-json")
  packageCount Int      @default(0)
  contentJson  Json
  createdAt    DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Exception de Security Gate : justifiée, limitée dans le temps et auditée.
model SecurityGateException {
  id          String   @id @default(cuid())
  projectId   String
  category    String   @default("ALL") // ALL | SECRET | SAST | SCA | IMAGE | IAC | DAST
  severity    String?  // null = toutes les sévérités
  reason      String
  createdById String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([expiresAt])
}

// ============================================================
// DEPLOYMENT
// ============================================================

model DeploymentServer {
  id                  String         @id @default(cuid())
  ownerId             String
  name                String
  host                String
  sshPort             Int            @default(22)
  username            String         @default("deploy")
  authType            ServerAuthType @default(SSH_KEY)
  encryptedPrivateKey String?
  encryptedPassphrase String?
  status              String         @default("unknown")
  lastCheckedAt       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects    Project[]
  deployments Deployment[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Deployment {
  id             String           @id @default(cuid())
  pipelineId     String           @unique
  projectId      String
  serverId       String
  status         DeploymentStatus @default(QUEUED)
  environment    String           @default("PRODUCTION") // STAGING | PRODUCTION
  imageTag       String?
  releaseVersion String?
  url            String?
  stagingUrl     String?
  stagingStatus  DeploymentStatus?
  productionUrl  String?
  productionStatus DeploymentStatus?
  rollbackImageTag String?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  error          String?
  createdAt      DateTime         @default(now())

  pipeline Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server   DeploymentServer @relation(fields: [serverId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([serverId])
  @@index([status])
}

// ============================================================
// REPORTS & AUDIT
// ============================================================

model SecurityReport {
  id          String   @id @default(cuid())
  pipelineId  String   @unique
  projectId   String
  summaryJson Json
  htmlPath    String?
  pdfPath     String?
  createdAt   DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  targetType   String?
  targetId     String?
  metadataJson Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// WEBHOOKS
// ============================================================

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String // GITHUB, GITLAB
  eventType      String // push, installation, installation_repositories, ping
  deliveryId     String    @unique
  payloadJson    Json
  signatureValid Boolean   @default(true)
  status         String    @default("received") // received, processed, ignored, failed
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  projectId      String?
  pipelineId     String?
  errorMessage   String?

  @@index([deliveryId])
  @@index([eventType])
  @@index([receivedAt])
  @@index([projectId])
}

// ============================================================
// SYSTEM CONFIGURATION
// ============================================================

/// Configuration globale de la plateforme (singleton).
/// Idéalement un seul enregistrement avec id="singleton".
model SystemConfig {
  id      String   @id @default(cuid())
  /// Clé logique pour identifier le singleton : toujours "default"
  key     String   @unique
  /// true si l'intégration GitHub App est complètement configurée
  githubConfigured Boolean @default(false)

  /// App ID GitHub (visible sur la page settings/apps)
  githubAppId     String?
  /// Slug de l'App (utilisé dans les URLs d'installation)
  githubAppSlug   String?
  /// Clé privée PEM chiffrée (AES-256-GCM)
  githubPrivateKeyEncrypted String?
  /// Webhook secret chiffré
  githubWebhookSecretEncrypted String?
  /// Client ID (optionnel, pour flux user-to-server)
  githubClientId     String?
  /// Client Secret chiffré (optionnel)
  githubClientSecretEncrypted String?

  /// Métadonnées
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}