// devsecops-platform/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

/// Rôle global de la plateforme.
/// Les valeurs ADMIN/DEVELOPER sont conservées temporairement pour la
/// compatibilité des jetons et des données historiques ; la migration les
/// convertit vers PLATFORM_ADMIN/PLATFORM_USER. Aucun nouveau compte ne doit
/// recevoir les anciennes valeurs.
enum Role {
  PLATFORM_ADMIN
  PLATFORM_USER
  ADMIN
  DEVELOPER
}

/// Statut du compte humain.
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

/// Rôle d'un utilisateur dans un projet DevSecOps.
/// Distinct des rôles GitHub : aucune permission GitHub n'en découle.
enum ProjectRole {
  OWNER
  MAINTAINER
  DEVELOPER
  SECURITY_ANALYST
  REPORTER
  GUEST
}

enum ProjectMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Portée d'une permission spéciale.
enum PermissionScopeType {
  GLOBAL
  PROJECT
}

/// Permissions spéciales indépendantes des rôles et de GitHub.
enum SpecialPermission {
  APPROVE_PRODUCTION
  MANAGE_SECURITY_POLICY
  MANAGE_SERVERS
  MANAGE_INTEGRATIONS
  MANAGE_PROJECT_MEMBERS
  MANAGE_GITHUB_TEAMS
  ACCEPT_SECURITY_RISK
  MANAGE_DEPLOYMENTS
  MANAGE_PROJECT_SECRETS
  VIEW_SECURITY_AUDIT
}

/// Rôle interne d'une équipe GitHub rattachée à un projet DevSecOps.
/// Ce rôle ne modifie JAMAIS les permissions GitHub : il est appliqué
/// uniquement par l'API DevSecOps Manager.
enum ProjectTeamRole {
  OWNER
  MAINTAINER
  DEVELOPER
  SECURITY_ANALYST
  VIEWER
}

/// État de synchronisation du cache local d'une équipe GitHub.
/// GitHub reste la source de vérité : DELETED signifie que l'équipe
/// n'existe plus côté GitHub (supprimée ou accès retiré).
enum GitHubTeamSyncState {
  SYNCED
  DELETED
  ERROR
}

enum GitProvider {
  GITHUB
  GITLAB
}

enum Technology {
  NODEJS
  PHP
  PYTHON
  UNKNOWN
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  SUCCESS_WITH_WARNINGS
  FAILED
  SECURITY_BLOCKED
  CANCELLED
  TIMED_OUT
  WAITING_APPROVAL
}

enum StepStatus {
  QUEUED
  RUNNING
  SUCCESS
  SUCCESS_WITH_WARNINGS
  FAILED
  SECURITY_BLOCKED
  CANCELLED
  SKIPPED
  TIMED_OUT
  WAITING_APPROVAL
}

enum ScanOutcome {
  SUCCESS_NO_FINDINGS
  SUCCESS_WITH_FINDINGS
  INTERRUPTED
  SCANNER_UNAVAILABLE
  PARSE_ERROR
  NOT_APPLICABLE
  DISABLED
  REQUIRED_NOT_RUN
}

enum SecurityGateExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum SecurityGateExceptionMatchType {
  ANY
  FINGERPRINT
  CVE
  RULE
  REFERENCE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum ScanType {
  SECRET
  SAST
  SCA
  IMAGE
  IAC
  DAST
}

enum SecurityGateStatus {
  PASSED
  WARNING
  FAILED
  BLOCKED
}

enum SecurityGateMode {
  WARNING
  ENFORCEMENT
}

enum VulnerabilityStatus {
  OPEN
  CONFIRMED
  FIXED
  FALSE_POSITIVE
  RISK_ACCEPTED
  DUPLICATE
}

enum DeploymentStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ServerAuthType {
  SSH_KEY
  PASSWORD
}

/// Décision humaine explicite avant toute promotion en production.
enum DeploymentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum NotificationKind {
  SUCCESS
  WARNING
  DANGER
  INFO
}

/// Cycle de réévaluation périodique d'un artefact déjà déployé.
/// Un rescan ne crée jamais de livraison : il produit un rapport de risque.
enum CosignMode {
  DISABLED
  WARNING
  REQUIRED
}

enum RescanStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  CANCELLED
}

/// Résultat déterministe des contrôles exécutés après un déploiement.
enum DeploymentVerificationStatus {
  PASSED
  FAILED
  SKIPPED
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String?    @unique
  passwordHash String
  name         String
  /// Rôle global. Le champ historique `role` reste le nom utilisé par l'API.
  role         Role       @default(PLATFORM_USER)
  status       UserStatus @default(ACTIVE)
  /// Miroir de compatibilité : `status === ACTIVE`.
  isActive     Boolean    @default(true)
  /// Incrémenté à chaque changement de rôle/statut/mot de passe ou révocation.
  /// Les JWT contiennent cette version et sont rejetés si elle ne correspond plus.
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projects                     Project[]
  projectMemberships           ProjectMember[]
  projectInvitationsSent       ProjectInvitation[]          @relation("ProjectInvitationInviter")
  projectInvitationsAccepted   ProjectInvitation[]          @relation("ProjectInvitationAcceptor")
  permissionGrantsReceived     PermissionGrant[]            @relation("PermissionGrantUser")
  permissionGrantsIssued       PermissionGrant[]            @relation("PermissionGrantIssuer")
  projectMembersInvited        ProjectMember[]              @relation("ProjectMemberInviter")
  githubInstallations          GitHubInstallation[]
  servers                      DeploymentServer[]
  auditLogs                    AuditLog[]
  securityGateExceptions       SecurityGateException[]      @relation("GateExceptionRequester")
  approvedGateExceptions       SecurityGateException[]      @relation("GateExceptionApprover")
  securityGateExceptionEvents  SecurityGateExceptionEvent[]
  assignedVulnerabilities      Vulnerability[]
  notifications                Notification[]
  deploymentApprovalsRequested DeploymentApproval[]         @relation("DeploymentApprovalRequester")
  deploymentApprovalsDecided   DeploymentApproval[]         @relation("DeploymentApprovalDecider")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ============================================================
// GITHUB APP
// ============================================================

/// Une installation GitHub App (peut être un compte perso ou une organisation).
/// Un utilisateur peut avoir plusieurs installations (perso + orgs).
model GitHubInstallation {
  id              String    @id @default(cuid())
  installationId  String    @unique // ID numérique GitHub (stocké en string)
  accountLogin    String // "marcel614-web" ou "mon-org"
  accountType     String // "User" | "Organization"
  accountId       String // ID GitHub du compte
  targetType      String // "User" | "Organization"
  userId          String // propriétaire côté plateforme
  suspendedAt     DateTime?
  revokedAt       DateTime?
  lastOrgSyncedAt DateTime?
  orgSyncState    String? // SYNCED | ERROR — état de la dernière synchro organisation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]
  teams        GitHubTeam[]

  @@index([userId])
  @@index([accountLogin])
  @@index([revokedAt])
}

/// Un repository accessible via une installation GitHub App.
/// Synchronisé depuis l'API GitHub à la demande.
model GitHubRepository {
  id             String   @id @default(cuid())
  repositoryId   String // ID numérique GitHub (stocké en string)
  fullName       String // "owner/repo"
  owner          String
  name           String
  private        Boolean  @default(false)
  defaultBranch  String   @default("main")
  language       String?
  description    String?
  htmlUrl        String
  installationId String // FK vers GitHubInstallation.id (pas l'ID GitHub)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([installationId, repositoryId])
  @@index([installationId])
  @@index([fullName])
  @@index([repositoryId])
}

/// Cache local d'une équipe GitHub (source de vérité = API GitHub).
/// La table existe pour conserver l'identifiant stable GitHub et permettre
/// les associations avec les projets DevSecOps. Les membres ne sont PAS
/// dupliqués : ils sont toujours lus en direct depuis GitHub.
model GitHubTeam {
  id             String              @id @default(cuid())
  installationId String // FK vers GitHubInstallation.id (pas l'ID GitHub)
  githubTeamId   String // ID numérique GitHub (stable)
  orgLogin       String
  slug           String
  name           String
  description    String?
  privacy        String              @default("closed") // "secret" | "closed"
  parentTeamId   String? // ID GitHub de l'équipe parente
  parentTeamSlug String?
  htmlUrl        String
  membersCount   Int?
  reposCount     Int?
  syncState      GitHubTeamSyncState @default(SYNCED)
  lastSyncedAt   DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  projectLinks ProjectTeam[]

  @@unique([installationId, githubTeamId])
  @@index([installationId])
  @@index([orgLogin])
  @@index([slug])
  @@index([syncState])
}

/// Association entre une équipe GitHub et un projet DevSecOps.
/// Le rôle est purement interne : il ne modifie jamais les permissions GitHub.
model ProjectTeam {
  id           String          @id @default(cuid())
  projectId    String
  githubTeamId String // FK vers GitHubTeam.id (cache local)
  role         ProjectTeamRole @default(VIEWER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    GitHubTeam @relation(fields: [githubTeamId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubTeamId])
  @@index([projectId])
  @@index([githubTeamId])
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id                 String      @id @default(cuid())
  ownerId            String
  name               String
  description        String?
  provider           GitProvider @default(GITHUB)
  repoFullName       String // gardé pour compat + affichage rapide
  repoId             String // ID GitHub du repository (garde pour compat)
  defaultBranch      String      @default("main")
  technology         Technology  @default(UNKNOWN)
  deploymentEnabled  Boolean     @default(false)
  serverId           String?
  githubRepositoryId String? // FK vers GitHubRepository
  monitoredBranch    String? // branche surveillée par les webhooks
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  owner                   User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  server                  DeploymentServer?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  githubRepository        GitHubRepository?        @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  config                  ProjectConfiguration?
  pipelines               Pipeline[]
  scans                   SecurityScan[]
  deployments             Deployment[]
  reports                 SecurityReport[]
  securityGateExceptions  SecurityGateException[]
  securityPolicies        PipelineSecurityPolicy[]
  sboms                   Sbom[]
  deploymentApprovals     DeploymentApproval[]
  deploymentLock          DeploymentLock?
  rescanRuns              RescanRun[]
  deploymentVerifications DeploymentVerification[]
  teamLinks               ProjectTeam[]
  members                 ProjectMember[]
  invitations             ProjectInvitation[]

  @@unique([ownerId, repoFullName])
  @@index([ownerId])
  @@index([repoFullName])
  @@index([githubRepositoryId])
}

/// Appartenance d'un utilisateur à un projet et rôle interne associé.
/// L'unicité (projectId, userId) empêche les doublons.
model ProjectMember {
  id          String              @id @default(cuid())
  userId      String
  projectId   String
  role        ProjectRole         @default(GUEST)
  status      ProjectMemberStatus @default(ACTIVE)
  invitedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("ProjectMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([role])
  @@index([status])
}

/// Invitation à rejoindre un projet. Le jeton brut n'est jamais stocké :
/// seul son hash SHA-256 est conservé.
model ProjectInvitation {
  id           String      @id @default(cuid())
  projectId    String
  email        String
  role         ProjectRole
  tokenHash    String      @unique
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("ProjectInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("ProjectInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId, email])
  @@index([email])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Permission spéciale explicite, avec portée globale ou projet.
/// Une permission projet ne donne aucun droit sur un autre projet.
model PermissionGrant {
  id          String              @id @default(cuid())
  userId      String
  permission  SpecialPermission
  scopeType   PermissionScopeType
  scopeId     String?
  grantedById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User @relation("PermissionGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PermissionGrantIssuer", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([userId, permission, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ProjectConfiguration {
  id                        String           @id @default(cuid())
  projectId                 String           @unique
  triggerBranches           String[]
  gitleaksEnabled           Boolean          @default(true)
  semgrepEnabled            Boolean          @default(true)
  scaEnabled                Boolean          @default(true)
  iacEnabled                Boolean          @default(true)
  trivyEnabled              Boolean          @default(true)
  syftEnabled               Boolean          @default(true)
  zapEnabled                Boolean          @default(true)
  cosignEnabled             Boolean          @default(false)
  cosignMode                CosignMode       @default(DISABLED)
  securityGateCritical      Int              @default(0)
  securityGateHigh          Int              @default(2)
  securityGateMedium        Int              @default(10)
  securityGateLow           Int              @default(-1)
  gateMode                  SecurityGateMode @default(WARNING)
  gateEnforcementAt         DateTime?
  gateSecretsEnabled        Boolean          @default(true)
  gateSastEnabled           Boolean          @default(true)
  gateScaEnabled            Boolean          @default(true)
  gateIacEnabled            Boolean          @default(true)
  gateImageEnabled          Boolean          @default(true)
  gateDastEnabled           Boolean          @default(true)
  deploymentStrategy        String           @default("direct") // direct | staging_then_production
  stagingPort               Int? // null = allocation automatique au déploiement
  productionPort            Int? // null = allocation automatique au déploiement
  autoRollback              Boolean          @default(true)
  /// Exige une décision humaine (utilisateur autorisé) liée au commit et au
  /// digest de l'image avant la promotion staging → production.
  requireProductionApproval Boolean          @default(false)
  /// Contrôles protégés : un DEVELOPER ne peut pas les désactiver.
  mandatoryControls         String[]         @default(["SECRET", "SCA"])
  /// Une exception doit être approuvée par un ADMIN avant d'être appliquée.
  requireExceptionApproval  Boolean          @default(true)
  /// Contrôles Ansible : lint statique et syntax-check, sans exécution des
  /// playbooks. Ils complètent `trivy config`, ils ne le remplacent pas.
  ansibleLintEnabled        Boolean          @default(true)
  ansibleSyntaxCheckEnabled Boolean          @default(true)
  ansibleTimeoutMs          Int              @default(300000)
  ansibleMaxPlaybooks       Int              @default(20)
  /// Vérifications déterministes après déploiement (conteneur, endpoint,
  /// port, digest). Elles constatent l'état réel, elles ne le modifient pas.
  postDeployChecksEnabled   Boolean          @default(true)
  healthcheckPath           String           @default("/")
  healthcheckTimeoutMs      Int              @default(5000)
  /// Réévaluation périodique des artefacts déployés. Désactivé par défaut
  /// pour ne pas consommer les ressources du worker sans décision explicite.
  rescanEnabled             Boolean          @default(false)
  rescanIntervalHours       Int              @default(24)
  /// Contrôles supportés pour un artefact déjà livré. Aujourd'hui IMAGE
  /// (Trivy sur la VM, via le digest immuable).
  rescanControls            String[]         @default(["IMAGE"])
  rescanTimeoutMs           Int              @default(1200000)
  rescanMaxRunsPerDay       Int              @default(1)
  rescanNextRunAt           DateTime?
  rescanLastRunAt           DateTime?
  /// Autorise explicitement la création d'un pipeline de correction sur un
  /// nouveau commit. Aucun déploiement automatique n'est déclenché.
  rescanRemediationEnabled  Boolean          @default(false)
  /// Intégration DefectDojo optionnelle au niveau projet.
  defectDojoEnabled         Boolean          @default(false)
  defectDojoProductId       Int?
  defectDojoEngagementId    Int?
  /// Incrémentée à chaque modification de la politique de sécurité.
  policyVersion             Int              @default(1)
  policyUpdatedAt           DateTime         @default(now())
  policyUpdatedById         String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// PIPELINES
// ============================================================

model Pipeline {
  id                String         @id @default(cuid())
  projectId         String
  commitSha         String
  branch            String
  author            String
  trigger           String         @default("push")
  /// Utilisateur humain ayant déclenché le pipeline (si lancement manuel).
  triggeredById     String?
  status            PipelineStatus @default(QUEUED)
  pullRequestNumber Int?
  pullRequestUrl    String?
  baseBranch        String?
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps                   PipelineStep[]
  logs                    PipelineLog[]
  scans                   SecurityScan[]
  gateResult              SecurityGateResult?
  gateEvaluations         PipelineGateEvaluation[]
  securityPolicy          PipelineSecurityPolicy?
  deployment              Deployment?
  report                  SecurityReport?
  dockerImage             DockerImage?
  sbom                    Sbom?
  approval                DeploymentApproval?
  deploymentLock          DeploymentLock?
  rescanRuns              RescanRun[]
  deploymentVerifications DeploymentVerification[]

  @@index([projectId])
  @@index([status])
  @@index([commitSha])
  @@index([createdAt])
  @@index([triggeredById])
}

model PipelineStep {
  id         String     @id @default(cuid())
  pipelineId String
  name       String
  type       String
  order      Int
  status     StepStatus @default(QUEUED)
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  exitCode   Int?
  resultJson Json?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  logs     PipelineLog[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([status])
}

model PipelineLog {
  id         String   @id @default(cuid())
  pipelineId String
  stepId     String?
  level      String   @default("info")
  message    String
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  step     PipelineStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@index([stepId])
  @@index([createdAt])
}

// ============================================================
// SECURITY
// ============================================================

model SecurityScan {
  id             String       @id @default(cuid())
  /// Un scan de pipeline possède un pipelineId. Un rescan périodique n'est
  /// rattaché à aucun pipeline : il porte uniquement `rescanRunId`.
  pipelineId     String?
  rescanRunId    String?
  projectId      String
  scanner        String
  /// Version de l'outil réellement exécutée (traçabilité des résultats).
  scannerVersion String?
  type           ScanType
  status         StepStatus   @default(QUEUED)
  /// Résultat normalisé du scanner, distinct du statut de l'étape.
  outcome        ScanOutcome?
  criticalCount  Int          @default(0)
  highCount      Int          @default(0)
  mediumCount    Int          @default(0)
  lowCount       Int          @default(0)
  infoCount      Int          @default(0)
  rawResultJson  Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  exitCode       Int?
  createdAt      DateTime     @default(now())

  pipeline        Pipeline?       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  rescanRun       RescanRun?      @relation(fields: [rescanRunId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vulnerabilities Vulnerability[]

  @@index([pipelineId])
  @@index([rescanRunId])
  @@index([projectId])
  @@index([scanner])
}

model Vulnerability {
  id           String              @id @default(cuid())
  scanId       String
  tool         String
  technology   String?
  severity     Severity
  packageName  String?
  filePath     String?
  version      String?
  fixedVersion String?
  description  String?
  reference    String?
  fingerprint  String?
  status       VulnerabilityStatus @default(OPEN)
  firstSeenAt  DateTime            @default(now())
  lastSeenAt   DateTime            @default(now())
  occurrences  Int                 @default(1)
  assignedToId String?
  notes        String?
  dueDate      DateTime?
  detectedAt   DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  scan       SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([severity])
  @@index([tool])
  @@index([fingerprint])
  @@index([status])
  @@index([assignedToId])
}

model SecurityGateResult {
  id                String             @id @default(cuid())
  pipelineId        String             @unique
  status            SecurityGateStatus
  mode              SecurityGateMode   @default(WARNING)
  rulesJson         Json
  critical          Int                @default(0)
  high              Int                @default(0)
  medium            Int                @default(0)
  low               Int                @default(0)
  blocked           Boolean            @default(false)
  reason            String?
  technicalFailures Json?
  exceptionsApplied Json?
  createdAt         DateTime           @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Instantané immuable de la politique utilisée par un pipeline.
/// Aucune API de mise à jour n'est exposée : une nouvelle exécution crée un
/// nouvel instantané. Les décisions passées ne sont jamais recalculées.
model PipelineSecurityPolicy {
  id         String   @id @default(cuid())
  pipelineId String   @unique
  projectId  String
  version    Int
  policyHash String
  policyJson Json
  createdAt  DateTime @default(now())

  pipeline    Pipeline                 @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluations PipelineGateEvaluation[]

  @@index([projectId])
  @@index([policyHash])
}

/// Résultat d'un gate précis (avant déploiement, après DAST, etc.).
model PipelineGateEvaluation {
  id                String             @id @default(cuid())
  pipelineId        String
  policySnapshotId  String?
  gateKey           String // PRE_DEPLOY | POST_DAST
  status            SecurityGateStatus
  mode              SecurityGateMode
  blocked           Boolean            @default(false)
  thresholdsJson    Json
  controlsJson      Json
  exceptionsJson    Json?
  technicalFailures Json?
  countsJson        Json
  reason            String?
  evaluatedAt       DateTime           @default(now())

  pipeline       Pipeline                @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  policySnapshot PipelineSecurityPolicy? @relation(fields: [policySnapshotId], references: [id], onDelete: SetNull)

  @@unique([pipelineId, gateKey])
  @@index([pipelineId])
  @@index([status])
}

model DockerImage {
  id               String    @id @default(cuid())
  pipelineId       String    @unique
  imageTag         String
  imageId          String?
  /// Digest immuable de l'image construite (sha256:...). C'est la référence
  /// promue en production : le tag seul n'est jamais considéré comme fiable.
  imageDigest      String?
  digestAlgorithm  String    @default("sha256")
  digestVerifiedAt DateTime?
  sizeBytes        BigInt?
  registry         String?
  signed           Boolean   @default(false)
  signatureRef     String?
  createdAt        DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([imageDigest])
}

model Sbom {
  id           String   @id @default(cuid())
  pipelineId   String   @unique
  projectId    String
  format       String   @default("syft-json")
  packageCount Int      @default(0)
  contentJson  Json
  createdAt    DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Exception de Security Gate : justifiée, limitée dans le temps et auditée.
model SecurityGateException {
  id           String                         @id @default(cuid())
  projectId    String
  category     String                         @default("ALL") // ALL | SECRET | SAST | SCA | IMAGE | IAC | DAST
  severity     String? // null = toutes les sévérités
  /// CVE, GHSA, règle Semgrep, référence ou empreinte du finding.
  /// Obligatoire : une exception limitée à une catégorie/sévérité masquait
  /// sinon TOUS les findings du bucket.
  fingerprint  String?
  matchType    SecurityGateExceptionMatchType @default(ANY)
  reason       String
  status       SecurityGateExceptionStatus    @default(PENDING)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  project    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?                        @relation("GateExceptionRequester", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?                        @relation("GateExceptionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  events     SecurityGateExceptionEvent[]

  @@index([projectId])
  @@index([fingerprint])
  @@index([expiresAt])
  @@index([status])
}

/// Historique append-only des modifications d'une exception.
model SecurityGateExceptionEvent {
  id           String   @id @default(cuid())
  exceptionId  String
  actorId      String?
  action       String // REQUESTED | APPROVED | REJECTED | REVOKED | EXPIRED | UPDATED
  fromStatus   String?
  toStatus     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  exception SecurityGateException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  actor     User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([exceptionId])
  @@index([createdAt])
}

// ============================================================
// DEPLOYMENT
// ============================================================

model DeploymentServer {
  id                  String         @id @default(cuid())
  ownerId             String
  name                String
  host                String
  sshPort             Int            @default(22)
  username            String         @default("deploy")
  authType            ServerAuthType @default(SSH_KEY)
  encryptedPrivateKey String?
  encryptedPassphrase String?
  /// Référence de confiance de la clé d'hôte SSH, au format OpenSSH
  /// `SHA256:<base64 sans padding>`. Absente = aucune connexion autorisée.
  hostKeyFingerprint  String?
  hostKeyAlgorithm    String?
  hostKeyTrustedAt    DateTime?
  status              String         @default("unknown")
  lastCheckedAt       DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects    Project[]
  deployments Deployment[]
  rescanRuns  RescanRun[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Deployment {
  id                   String            @id @default(cuid())
  pipelineId           String            @unique
  projectId            String
  serverId             String
  status               DeploymentStatus  @default(QUEUED)
  environment          String            @default("PRODUCTION") // STAGING | PRODUCTION
  imageTag             String?
  /// Digest exact de l'artefact validé puis promu. La promotion ne
  /// reconstruit jamais l'image et vérifie ce digest sur la VM.
  imageDigest          String?
  releaseVersion       String?
  url                  String?
  stagingUrl           String?
  stagingStatus        DeploymentStatus?
  productionUrl        String?
  productionStatus     DeploymentStatus?
  rollbackImageTag     String?
  rollbackImageDigest  String?
  previousDeploymentId String?
  startedAt            DateTime?
  finishedAt           DateTime?
  durationMs           Int?
  error                String?

  createdAt DateTime @default(now())

  pipeline      Pipeline                 @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server        DeploymentServer         @relation(fields: [serverId], references: [id], onDelete: Restrict)
  approval      DeploymentApproval?
  rescanRuns    RescanRun[]
  verifications DeploymentVerification[]

  @@index([projectId])
  @@index([serverId])
  @@index([status])
  @@index([imageDigest])
}

/// Constat déterministe de l'état d'un déploiement (conteneur, endpoint,
/// port, version/digest). Aucun scan IaC ne peut produire ce constat.
model DeploymentVerification {
  id           String                       @id @default(cuid())
  projectId    String
  deploymentId String
  pipelineId   String
  environment  String
  status       DeploymentVerificationStatus @default(FAILED)
  imageTag     String?
  imageDigest  String?
  checksJson   Json
  summaryJson  Json?
  error        String?
  startedAt    DateTime                     @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime                     @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  pipeline   Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, environment])
  @@index([projectId, createdAt])
  @@index([status])
}

/// Exécution de réévaluation d'un artefact déjà déployé. `cycleKey` et
/// `deploymentId` sont uniques ensemble : deux tâches planifiées concurrentes
/// ne peuvent pas créer deux rescans pour la même version et le même cycle.
model RescanRun {
  id             String       @id @default(cuid())
  projectId      String
  deploymentId   String
  pipelineId     String?
  serverId       String
  environment    String
  commitSha      String
  branch         String
  imageTag       String?
  imageDigest    String
  cycleKey       String
  trigger        String       @default("SCHEDULED") // SCHEDULED | MANUAL
  status         RescanStatus @default(QUEUED)
  controls       String[]     @default(["IMAGE"])
  timeoutMs      Int          @default(1200000)
  scannerVersion String?
  summaryJson    Json?
  /// Rapport d'évolution : nouveaux findings, changements de sévérité,
  /// findings résolus et référence à la baseline utilisée.
  comparisonJson Json?
  error          String?
  queuedAt       DateTime     @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  server     DeploymentServer @relation(fields: [serverId], references: [id], onDelete: Restrict)
  scans      SecurityScan[]

  @@unique([deploymentId, cycleKey])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([imageDigest])
  @@index([status, startedAt])
}

/// Verrou de déploiement par projet : empêche deux pipelines de modifier
/// simultanément le même environnement. Le verrou est libéré explicitement
/// et possède une expiration de secours en cas de crash du worker.
model DeploymentLock {
  id          String   @id @default(cuid())
  projectId   String   @unique
  pipelineId  String   @unique
  environment String
  acquiredAt  DateTime @default(now())
  expiresAt   DateTime

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([pipelineId])
}

/// Approbation humaine liée à un pipeline, un commit et un digest précis.
/// Une décision ne peut jamais être réutilisée pour un autre artefact.
model DeploymentApproval {
  id            String                   @id @default(cuid())
  pipelineId    String                   @unique
  projectId     String
  deploymentId  String?                  @unique
  environment   String                   @default("PRODUCTION")
  commitSha     String
  imageTag      String
  imageDigest   String
  status        DeploymentApprovalStatus @default(PENDING)
  requestedById String?
  requestedAt   DateTime                 @default(now())
  decidedById   String?
  decidedAt     DateTime?
  comment       String?
  expiresAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  pipeline    Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment  Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  requestedBy User?       @relation("DeploymentApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?       @relation("DeploymentApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// REPORTS & AUDIT
// ============================================================

model SecurityReport {
  id          String   @id @default(cuid())
  pipelineId  String   @unique
  projectId   String
  summaryJson Json
  htmlPath    String?
  pdfPath     String?
  createdAt   DateTime @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DefectDojoImport {
  id           String   @id @default(cuid())
  projectId    String
  pipelineId   String?
  engagementId Int
  status       String   @default("PENDING") // PENDING, SUCCESS, FAILED
  externalId   String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([pipelineId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  targetType   String?
  targetId     String?
  /// Projet concerné par l'action (permet l'audit par projet).
  projectId    String?
  /// SUCCESS | DENIED | ERROR
  result       String   @default("SUCCESS")
  /// Origine technique : api, worker, webhook, etc.
  origin       String?
  metadataJson Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([projectId])
  @@index([result])
  @@index([createdAt])
}

// ============================================================
// WEBHOOKS
// ============================================================

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String // GITHUB, GITLAB
  eventType      String // push, installation, installation_repositories, ping
  deliveryId     String    @unique
  payloadJson    Json
  signatureValid Boolean   @default(true)
  status         String    @default("received") // received, processed, ignored, failed
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  projectId      String?
  pipelineId     String?
  errorMessage   String?

  @@index([deliveryId])
  @@index([eventType])
  @@index([receivedAt])
  @@index([projectId])
}

// ============================================================
// SYSTEM CONFIGURATION
// ============================================================

/// Configuration globale de la plateforme (singleton).
/// Idéalement un seul enregistrement avec id="singleton".
model SystemConfig {
  id               String  @id @default(cuid())
  /// Clé logique pour identifier le singleton : toujours "default"
  key              String  @unique
  /// true si l'intégration GitHub App est complètement configurée
  githubConfigured Boolean @default(false)

  /// App ID GitHub (visible sur la page settings/apps)
  githubAppId                  String?
  /// Slug de l'App (utilisé dans les URLs d'installation)
  githubAppSlug                String?
  /// Clé privée PEM chiffrée (AES-256-GCM)
  githubPrivateKeyEncrypted    String?
  /// Webhook secret chiffré
  githubWebhookSecretEncrypted String?
  /// Client ID (optionnel, pour flux user-to-server)
  githubClientId               String?
  /// Client Secret chiffré (optionnel)
  githubClientSecretEncrypted  String?

  /// Intégration DefectDojo (optionnelle, désactivée par défaut)
  defectDojoConfigured        Boolean @default(false)
  defectDojoUrl               String?
  defectDojoApiTokenEncrypted String?

  /// Intégration Dependency-Track (optionnelle, désactivée par défaut)
  dependencyTrackConfigured      Boolean @default(false)
  dependencyTrackUrl             String?
  dependencyTrackApiKeyEncrypted String?

  /// Métadonnées
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

/// Notification persistée, propre à un utilisateur.
/// `sourceKey` permet une synchronisation idempotente depuis les pipelines.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  sourceKey String
  kind      NotificationKind
  title     String
  message   String?
  link      String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, deletedAt])
}
